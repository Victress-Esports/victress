# --- Supabase (Project Settings > API). These are the names to set in Vercel (Production and Preview separately).
# SUPABASE_URL and SUPABASE_ANON_KEY are public by design: next.config.ts maps them to NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY for the code, and they ship to the browser. Row Level Security protects the data.
# The build fails if either is missing. Locally the NEXT_PUBLIC_ names still work as a fallback.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never mapped in next.config.ts, never in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (resend.com > API Keys). Verify victressesports.com as a sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@victressesports.com

# --- Stripe (test mode only; scaffold behind the flag below)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_ENABLED=false
# Test-mode price IDs (recorded in docs/stripe.md; used at M4). Server only.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_SCOUT_MONTHLY=

# --- Product
# Default game and homepage focus only. All six games stay available in onboarding and profiles.
NEXT_PUBLIC_LAUNCH_GAME=VALORANT
# Server only. Includes labeled demo players on leaderboards. true ONLY in dev/preview, never production.
LEADERBOARD_INCLUDE_DEMO=false

# --- Domains (use http://marketing.localhost:3000 and http://app.localhost:3000 in local dev)
NEXT_PUBLIC_MARKETING_URL=https://victressesports.com
NEXT_PUBLIC_APP_URL=https://victress.gg

# Exposure features. All default off; turning one on needs its own approval (docs/proposals/privacy-rollout.md).
SHARING_ENABLED=false
DIRECTORY_ENABLED=false
SCRIM_UPLOADS_ENABLED=false
