# --- Supabase (Project Settings > API). Which pair is used depends on the environment (lib/supabase/resolve-env.ts):
#   Vercel Production (VERCEL_ENV=production): SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY  (the production project)
#   Vercel Preview    (VERCEL_ENV=preview):    STAGING_SUPABASE_URL, STAGING_SUPABASE_ANON_KEY, STAGING_SUPABASE_SERVICE_ROLE_KEY  (the staging project)
# A Preview NEVER falls back to the production names, and the build fails with a clear message if its STAGING_ values are missing.
# The URL and anon key are public by design (they ship to the browser; Row Level Security protects the data).
# Local development: set the STAGING_ trio to run against staging, or NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
# (with SUPABASE_SERVICE_ROLE_KEY) for the mock scripts. The production names are ignored locally on purpose.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never mapped in next.config.ts, never in a built file.
SUPABASE_SERVICE_ROLE_KEY=
# Preview only (set these in Vercel for the Preview environment, with the staging project's values).
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (resend.com > API Keys). Verify victressesports.com as a sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@victressesports.com

# --- Stripe (test mode only; scaffold behind the flag below)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Player billing (Pro, Team, Scout). false on Production. true only on Preview/staging after the founder approves. Test mode only.
NEXT_PUBLIC_BILLING_ENABLED=false
# Test-mode price IDs (recorded in docs/stripe.md; used at M4). Server only.
STRIPE_PRICE_PRO_MONTHLY=price_1UYdMWP3pSL2v8NHDOoAeNmv
STRIPE_PRICE_PRO_ANNUAL=price_1UYdMWP3pSL2v8NHhLbhhXsB
STRIPE_PRICE_TEAM_MONTHLY=price_1UYdMuP3pSL2v8NH2e7HWUZD
STRIPE_PRICE_SCOUT_MONTHLY=price_1UYdNCP3pSL2v8NHcIyuuyge
# Partner account billing. Server only. PARTNER_BILLING_ENABLED is a separate switch from NEXT_PUBLIC_BILLING_ENABLED (which stays false).
PARTNER_BILLING_ENABLED=false
# Stripe test mode price ids (not secrets). Supporting Partner $1,000 per month:
STRIPE_PRICE_PARTNER_SUPPORTING_MONTHLY=price_1Ua3keP3pSL2v8NHkQZLgZUE
# Supporting Partner $10,000 per year:
STRIPE_PRICE_PARTNER_SUPPORTING_ANNUAL=price_1Ua3keP3pSL2v8NH8uMUb9qS
# Anchor Partner $50,000 per year:
STRIPE_PRICE_PARTNER_ANCHOR_ANNUAL=price_1Ua3lDP3pSL2v8NHhsCZGaDZ
# Used only on a Stripe hosted invoice for an approved Category Exclusivity request, never in Checkout.
# Anchor Partner with Category Exclusivity, $85,000 per year (recurring annual price; only its amount is read):
STRIPE_PRICE_PARTNER_ANCHOR_EXCLUSIVE_ANNUAL=price_1Ua3oLP3pSL2v8NH4yWgAmKv

# --- Product
# Default game and homepage focus only. All six games stay available in onboarding and profiles.
NEXT_PUBLIC_LAUNCH_GAME=VALORANT
# Server only. Includes labeled demo players on leaderboards. true ONLY in dev/preview, never production.
LEADERBOARD_INCLUDE_DEMO=false

# --- Domains (use http://marketing.localhost:3000 and http://app.localhost:3000 in local dev)
NEXT_PUBLIC_MARKETING_URL=https://victressesports.com
NEXT_PUBLIC_APP_URL=https://victress.gg

# Exposure features. All default off; turning one on needs its own approval (docs/proposals/privacy-rollout.md).
SHARING_ENABLED=false
DIRECTORY_ENABLED=false
SCRIM_UPLOADS_ENABLED=false
